import java.io.File;
import java.io.FileNotFoundException;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.util.Arrays;
import java.util.List;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        String filename = "students.txt";
        writeStudentFile(filename);
        readStudentFile(filename);
    }

    private static void writeStudentFile(String filename) {
        File file = new File(filename);
        if (file.exists()) {
            System.out.println("Warning: " + filename + " already exists.");
        }

        List<String[]> students = Arrays.asList(
            new String[] {"Ali", "Karimov", "3.85", "ComputerScience"},
            new String[] {"Vali", "Karimov", "3.90", "Biology"},
            new String[] {"Karim", "Islomov", "3.70", "Mathematics"},
            new String[] {"Sarvar", "Azizov", "3.95", "English"},
            new String[] {"Jahon", "Boriyev", "3.80", "History"}
        );

        try (PrintWriter writer = new PrintWriter(new FileWriter(file))) {
            for (String[] student : students) {
                writer.printf("%s %s %s %s%n",
                    student[0], student[1], student[2], student[3]);
            }
            System.out.println("File written successfully.");
        } catch (IOException e) {
            System.out.println("Error writing file: " + e.getMessage());
        }
    }

    private static void readStudentFile(String filename) {
        File file = new File(filename);

        System.out.println("Name              GPA  Major");
        System.out.println("----------------------------------------");

        int count = 0;
        try (Scanner scanner = new Scanner(file)) {
            while (scanner.hasNextLine()) {
                String first = scanner.next();
                String last = scanner.next();
                String gpa = scanner.next();
                String major = scanner.next();
                System.out.printf("%-17s %-4s %s%n", first + " " + last, gpa, major);
                count++;
            }
            System.out.println("Total students: " + count);
        } catch (FileNotFoundException e) {
            System.out.println("Unable to open " + filename + ". Please make sure the file exists.");
        }
    }
}
